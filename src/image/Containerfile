# The Stack OS bootc image (decision 01), built by `task image:build` with
# src/ as the build context and output/rpms/ as the extra context `rpms`.
#
#   rootfs   Fedora's bootc image, used only as the tool that assembles the
#            minimal root filesystem (`build-rootfs --manifest=minimal`).
#   minimal  That root filesystem on its own: the base of the image.
#   image    Fedora's go-task, one RUN that installs every feature in order
#            (image/build/Taskfile.yml), then a RUN that finalizes. Nothing is
#            compiled: the Quickshell RPM comes from `task quickshell:rpm`.
ARG BOOTC_IMAGE

FROM ${BOOTC_IMAGE} AS rootfs
RUN /usr/libexec/bootc-base-imagectl build-rootfs --manifest=minimal /target-rootfs

FROM scratch AS minimal
COPY --from=rootfs /target-rootfs/ /

FROM minimal AS image
# Key of the Quickshell RPM to install, from the root Taskfile.
ARG QUICKSHELL_KEY
RUN dnf -y install --setopt=install_weak_deps=False go-task && dnf clean all
# src/ is mounted at /ctx (read-only) and output/rpms/ at /rpms; the dnf cache
# persists between builds. build/bin holds the feature helpers.
RUN --mount=type=bind,source=.,target=/ctx \
  --mount=type=bind,from=rpms,target=/rpms \
  --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
  env PATH=/ctx/image/build/bin:/usr/bin:/usr/sbin QUICKSHELL_RPM="/rpms/quickshell-${QUICKSHELL_KEY}.rpm" \
  go-task -d /ctx/image/build all
# finalize runs without the dnf cache mount, so no mount point is left in
# /var for `bootc container lint` to flag.
RUN --mount=type=bind,source=.,target=/ctx \
  env PATH=/ctx/image/build/bin:/usr/bin:/usr/sbin go-task -d /ctx/image/build finalize
LABEL containers.bootc=1 ostree.bootable=1
ENV container=oci
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
