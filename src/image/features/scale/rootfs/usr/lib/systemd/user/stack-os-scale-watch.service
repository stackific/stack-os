# Reruns the display-scale script on every monitor hotplug (decision 04).
# Started and stopped with Mango's session target, like the shell.
[Unit]
Description=Stack OS display scale on hotplug
PartOf=graphical-session.target
BindsTo=mango-session.target
After=mango-session.target

[Service]
ExecStart=/usr/libexec/stack-os/scale-watch
Restart=on-failure
RestartSec=1
Slice=session.slice
