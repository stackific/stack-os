# The Stack OS shell (decision 05): one Quickshell process for the bar, the
# power menu and the lock. Started by mango-session.target (the wants link
# beside this file), which Mango starts only after importing WAYLAND_DISPLAY
# and its other variables into the user manager, so the shell always finds
# the compositor. Bound to that target, so it stops when Mango exits instead
# of restarting against a compositor that is gone. Live QML reload is a
# development feature and is off here.
[Unit]
Description=Stack OS shell
PartOf=graphical-session.target
BindsTo=mango-session.target
After=mango-session.target

[Service]
ExecStart=/usr/bin/qs -p /usr/share/stack-os/shell
Environment=QS_DISABLE_FILE_WATCHER=1
Restart=on-failure
RestartSec=1
Slice=session.slice
