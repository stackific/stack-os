# The Stack OS session, the only one tuigreet offers: Mango with the image's
# own config under /usr (so nothing in /etc needs editing).
[Desktop Entry]
Name=Stack OS
Comment=Mango with the Stack OS shell
Exec=mango -c /usr/share/stack-os/mango/config.conf
Type=Application
DesktopNames=mango;wlroots
